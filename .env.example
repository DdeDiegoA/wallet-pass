# Copiar a .env y rellenar. NUNCA commitear valores reales.
# Todas opcionales: sin ellas la lib corre en dry-run.
#
# NOTA: en esta librería, APPLE_PASS_CERT y APPLE_WWDR_CERT son RUTAS a archivos
# PEM en disco (apple.ts las lee con readFile), NO el contenido PEM en línea.

# --- Apple Wallet ---

# Ruta al PEM COMBINADO: certificado Pass Type ID + su clave privada en el mismo
# archivo (`cat signer.pem signer.key > APPLE_PASS_CERT.pem`).
APPLE_PASS_CERT=

# Ruta al certificado WWDR intermedio de Apple (PEM).
APPLE_WWDR_CERT=

# Passphrase de la clave privada, solo si está cifrada.
APPLE_PASS_CERT_PASSPHRASE=

# Pass Type ID (p. ej. pass.tudominio.clases).
APPLE_PASS_TYPE_IDENTIFIER=

# Team ID de tu cuenta de Apple Developer.
APPLE_TEAM_IDENTIFIER=

# --- Google Wallet ---

# Contenido JSON completo del service account (no una ruta), con scope
# wallet_object.issuer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Issuer ID de la Pay & Wallet console. Sin esto, Google usa el default spike.
GOOGLE_ISSUER_ID=

# Orígenes permitidos del JWT "save to wallet", separados por coma.
# Ej: https://midominio.com,https://app.midominio.com
GOOGLE_JWT_ORIGINS=
